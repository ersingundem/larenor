[Unit]
Description=Larenor durable NUT power event bridge
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/var/lib/larenor-server/host-workers/power-recovery

[Service]
Type=simple
User=10006
Group=10006
SupplementaryGroups=nut
UMask=0077
RuntimeDirectory=larenor-power-recovery
RuntimeDirectoryMode=0770
ExecStartPre=/opt/larenor-server-host/current/server/bin/python -m larenor_server.power_recovery.nut_bridge --config /etc/larenor-server/host-workers/power-recovery/nut-bridge.json --upsmon-config /etc/nut/upsmon.conf check-config
ExecStart=/opt/larenor-server-host/current/server/bin/python -m larenor_server.power_recovery.nut_bridge --config /etc/larenor-server/host-workers/power-recovery/nut-bridge.json --upsmon-config /etc/nut/upsmon.conf worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/larenor-server/host-workers/power-recovery

[Install]
WantedBy=multi-user.target
