+static BOOL drive_larenor_handle_info(const DRIVE_FILE* file, LRN_HANDLE_INFO* info)
+{
+	BY_HANDLE_FILE_INFORMATION native = WINPR_C_ARRAY_INIT;
+	if (!file || !info)
+		return FALSE;
+	ZeroMemory(info, sizeof(*info));
+	if (file->file_handle == INVALID_HANDLE_VALUE)
+	{
+		if (!file->is_dir || !file->fullpath)
+			return FALSE;
+		char* fullpath = ConvertWCharToUtf8Alloc(file->fullpath, nullptr);
+		if (!fullpath)
+			return FALSE;
+		const int descriptor = open(fullpath, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		free(fullpath);
+		struct stat state = { 0 };
+		const BOOL valid = descriptor >= 0 && fstat(descriptor, &state) == 0 &&
+		                   S_ISDIR(state.st_mode);
+		if (descriptor >= 0)
+			close(descriptor);
+		if (!valid)
+			return FALSE;
+		info->volume = (uint32_t)state.st_dev;
+		info->inode = (uint32_t)state.st_ino;
+		info->size = (uint64_t)state.st_size;
+		info->links = (uint32_t)state.st_nlink;
+		info->directory = true;
+		info->valid = true;
+		return TRUE;
+	}
+	if (!GetFileInformationByHandle(file->file_handle, &native))
+		return FALSE;
+	info->volume = native.dwVolumeSerialNumber;
+	info->inode = native.nFileIndexLow;
+	info->size = ((uint64_t)native.nFileSizeHigh << 32U) | native.nFileSizeLow;
+	info->links = native.nNumberOfLinks;
+	info->directory = (native.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+	info->valid = true;
+	return TRUE;
+}
+
+static BOOL drive_larenor_write_requested(uint32_t access)
+{
+	const uint32_t write = GENERIC_WRITE | DELETE | WRITE_DAC | WRITE_OWNER | FILE_WRITE_DATA |
+	                       FILE_APPEND_DATA | FILE_WRITE_EA | FILE_WRITE_ATTRIBUTES;
+	return (access & write) != 0;
+}
+
+static char* drive_larenor_path_utf8(const WCHAR* path, size_t length)
+{
+	if (!path && length > 0)
+		return nullptr;
+	for (size_t x = 0; x < length; x++)
+	{
+		if (path[x] == 0)
+			return nullptr;
+	}
+	return ConvertWCharNToUtf8Alloc(path, length, nullptr);
+}
+
+static char* drive_larenor_fullpath_utf8(const DRIVE_FILE* file)
+{
+	if (!file || !file->fullpath)
+		return nullptr;
+	return ConvertWCharToUtf8Alloc(file->fullpath, nullptr);
+}
