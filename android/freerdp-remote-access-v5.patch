+#include "drive_larenor.h"
+
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+#ifndef O_DIRECTORY
+#define O_DIRECTORY 0
+#endif
+#ifndef O_NOFOLLOW
+#define O_NOFOLLOW 0
+#endif
+
+typedef enum
+{
+	LRN_PATH_ROOT = 0,
+	LRN_PATH_TO_REMOTE,
+	LRN_PATH_FROM_REMOTE
+} LRN_PATH_KIND;
+
+typedef struct
+{
+	LRN_PATH_KIND kind;
+	bool file;
+	char relative[320];
+	char name[256];
+} LRN_PATH;
+
+typedef struct
+{
+	uint64_t count;
+	uint64_t total;
+} LRN_SCAN;
+
+struct lrn_drive_policy
+{
+	char root[PATH_MAX];
+	char endpoint[PATH_MAX];
+	int source_fd;
+	int root_fd;
+	int to_fd;
+	int from_fd;
+	uid_t uid;
+	gid_t gid;
+	pthread_mutex_t mutex;
+	bool poisoned;
+};
+
+static bool lrn_add_u64(uint64_t a, uint64_t b, uint64_t* result)
+{
+	if (!result || (UINT64_MAX - a < b))
+		return false;
+	*result = a + b;
+	return true;
+}
+
+static bool lrn_valid_utf8(const unsigned char* value, size_t length)
+{
+	size_t x = 0;
+	while (x < length)
+	{
+		const unsigned char c = value[x++];
+		if (c <= 0x7F)
+		{
+			if (c == 0)
+				return false;
+			continue;
+		}
+		unsigned needed = 0;
+		uint32_t code = 0;
+		if ((c & 0xE0) == 0xC0)
+		{
+			needed = 1;
+			code = c & 0x1F;
+			if (code < 2)
+				return false;
+		}
+		else if ((c & 0xF0) == 0xE0)
+		{
+			needed = 2;
+			code = c & 0x0F;
+		}
+		else if ((c & 0xF8) == 0xF0)
+		{
+			needed = 3;
+			code = c & 0x07;
+		}
+		else
+			return false;
+		if (x + needed > length)
+			return false;
+		for (unsigned y = 0; y < needed; y++)
+		{
+			const unsigned char next = value[x++];
+			if ((next & 0xC0) != 0x80)
+				return false;
+			code = (code << 6) | (next & 0x3F);
+		}
+		if ((needed == 2 && code < 0x800) || (needed == 3 && code < 0x10000) ||
+		    code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF))
+			return false;
+	}
+	return true;
+}
+
+static bool lrn_ascii_equal_fold(const char* left, const char* right)
+{
+	if (!left || !right)
+		return false;
+	while (*left && *right)
+	{
+		unsigned char a = (unsigned char)*left++;
+		unsigned char b = (unsigned char)*right++;
+		if (a >= 'A' && a <= 'Z')
+			a = (unsigned char)(a + ('a' - 'A'));
+		if (b >= 'A' && b <= 'Z')
+			b = (unsigned char)(b + ('a' - 'A'));
+		if (a != b)
+			return false;
+	}
+	return *left == '\0' && *right == '\0';
+}
+
+static bool lrn_virtual_name(const char* name)
+{
+	char base[16] = { 0 };
+	size_t x = 0;
+	while (name[x] && name[x] != '.' && x + 1 < sizeof(base))
+	{
+		base[x] = (char)toupper((unsigned char)name[x]);
+		x++;
+	}
+	base[x] = '\0';
+	if (strcmp(base, "CON") == 0 || strcmp(base, "PRN") == 0 || strcmp(base, "AUX") == 0 ||
+	    strcmp(base, "NUL") == 0)
+		return true;
+	if (strlen(base) == 4 &&
+	    ((strncmp(base, "COM", 3) == 0) || (strncmp(base, "LPT", 3) == 0)) &&
+	    base[3] >= '1' && base[3] <= '9')
+		return true;
+	return false;
+}
+
+static bool lrn_valid_name(const char* name)
+{
+	if (!name)
+		return false;
+	const size_t length = strlen(name);
+	if (length < 1 || length > 255 || strcmp(name, ".") == 0 || strcmp(name, "..") == 0 ||
+	    name[0] == '.' || name[length - 1] == ' ' || name[length - 1] == '.')
+		return false;
+	if (!lrn_valid_utf8((const unsigned char*)name, length) || lrn_virtual_name(name))
+		return false;
+	for (size_t x = 0; x < length; x++)
+	{
+		const unsigned char c = (unsigned char)name[x];
+		if (c < 0x20 || c == 0x7F || c == '/' || c == '\\' || c == ':' || c == '*' ||
+		    c == '?' || c == '"' || c == '<' || c == '>' || c == '|')
+			return false;
+	}
+	return true;
+}
+
+static LRN_POLICY_RESULT lrn_parse_relative(const char* input, LRN_PATH* parsed)
+{
+	if (!input || !parsed)
+		return LRN_POLICY_INVALID_NAME;
+	memset(parsed, 0, sizeof(*parsed));
+	while (*input == '/' || *input == '\\')
+		input++;
+	const size_t length = strlen(input);
+	if (length >= sizeof(parsed->relative))
+		return LRN_POLICY_INVALID_NAME;
+	for (size_t x = 0; x < length; x++)
+		parsed->relative[x] = input[x] == '\\' ? '/' : input[x];
+	parsed->relative[length] = '\0';
+	if (length == 0)
+	{
+		parsed->kind = LRN_PATH_ROOT;
+		return LRN_POLICY_OK;
+	}
+	char* separator = strchr(parsed->relative, '/');
+	if (!separator)
+	{
+		if (strcmp(parsed->relative, "ToRemote") == 0)
+			parsed->kind = LRN_PATH_TO_REMOTE;
+		else if (strcmp(parsed->relative, "FromRemote") == 0)
+			parsed->kind = LRN_PATH_FROM_REMOTE;
+		else
+			return LRN_POLICY_INVALID_NAME;
+		return LRN_POLICY_OK;
+	}
+	if (strchr(separator + 1, '/') != NULL || separator[1] == '\0')
+		return LRN_POLICY_INVALID_NAME;
+	*separator = '\0';
+	if (strcmp(parsed->relative, "ToRemote") == 0)
+		parsed->kind = LRN_PATH_TO_REMOTE;
+	else if (strcmp(parsed->relative, "FromRemote") == 0)
+		parsed->kind = LRN_PATH_FROM_REMOTE;
+	else
+		return LRN_POLICY_INVALID_NAME;
+	if (!lrn_valid_name(separator + 1))
+		return LRN_POLICY_INVALID_NAME;
+	parsed->file = true;
+	memcpy(parsed->name, separator + 1, strlen(separator + 1) + 1);
+	*separator = '/';
+	return LRN_POLICY_OK;
+}
+
+static LRN_POLICY_RESULT lrn_parse_fullpath(const LRN_DRIVE_POLICY* policy, const char* fullpath,
+                                           LRN_PATH* parsed)
+{
+	if (!policy || !fullpath)
+		return LRN_POLICY_INVALID_NAME;
+	const size_t root_length = strlen(policy->endpoint);
+	if (strncmp(fullpath, policy->endpoint, root_length) != 0)
+		return LRN_POLICY_ACCESS_DENIED;
+	if (fullpath[root_length] == '\0')
+		return lrn_parse_relative("", parsed);
+	if (fullpath[root_length] != '/')
+		return LRN_POLICY_ACCESS_DENIED;
+	return lrn_parse_relative(fullpath + root_length + 1, parsed);
+}
+
+static int lrn_dirfd(const LRN_DRIVE_POLICY* policy, LRN_PATH_KIND kind)
+{
+	if (!policy)
+		return -1;
+	if (kind == LRN_PATH_TO_REMOTE)
+		return policy->to_fd;
+	if (kind == LRN_PATH_FROM_REMOTE)
+		return policy->from_fd;
+	return policy->root_fd;
+}
+
+static bool lrn_owned_dir(int fd, uid_t uid)
+{
+	struct stat state = { 0 };
+	return fd >= 0 && fstat(fd, &state) == 0 && S_ISDIR(state.st_mode) && state.st_uid == uid &&
+	       (state.st_mode & 07777) == 0700;
+}
+
+static bool lrn_exact_entry(int fd, const char* name, const struct stat* expected)
+{
+	int copy = openat(fd, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (copy < 0)
+		return false;
+	DIR* directory = fdopendir(copy);
+	if (!directory)
+	{
+		close(copy);
+		return false;
+	}
+	bool exact = false;
+	errno = 0;
+	for (struct dirent* entry = readdir(directory); entry; entry = readdir(directory))
+	{
+		if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
+			continue;
+		struct stat state = { 0 };
+		if (fstatat(fd, entry->d_name, &state, AT_SYMLINK_NOFOLLOW) != 0)
+			break;
+		if (state.st_dev == expected->st_dev && state.st_ino == expected->st_ino)
+		{
+			exact = strcmp(entry->d_name, name) == 0;
+			break;
+		}
+	}
+	const bool clean = errno == 0;
+	closedir(directory);
+	return clean && exact;
+}
+
+static LRN_POLICY_RESULT lrn_no_name_alias(const LRN_DRIVE_POLICY* policy, const LRN_PATH* path)
+{
+	if (!policy || !path || !path->file)
+		return LRN_POLICY_OK;
+	const int fd = lrn_dirfd(policy, path->kind);
+	const int copy = openat(fd, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (copy < 0)
+		return LRN_POLICY_IO_ERROR;
+	DIR* directory = fdopendir(copy);
+	if (!directory)
+	{
+		close(copy);
+		return LRN_POLICY_IO_ERROR;
+	}
+	LRN_POLICY_RESULT result = LRN_POLICY_OK;
+	errno = 0;
+	for (struct dirent* entry = readdir(directory); entry; entry = readdir(directory))
+	{
+		if (strcmp(entry->d_name, path->name) != 0 &&
+		    lrn_ascii_equal_fold(entry->d_name, path->name))
+		{
+			result = LRN_POLICY_ACCESS_DENIED;
+			break;
+		}
+	}
+	if (result == LRN_POLICY_OK && errno != 0)
+		result = LRN_POLICY_IO_ERROR;
+	closedir(directory);
+	return result;
+}
+
+static LRN_POLICY_RESULT lrn_stat_path(const LRN_DRIVE_POLICY* policy, const LRN_PATH* path,
+                                      struct stat* state, bool* exists)
+{
+	if (!policy || !path || !state || !exists)
+		return LRN_POLICY_IO_ERROR;
+	*exists = false;
+	if (!path->file)
+	{
+		const int fd = lrn_dirfd(policy, path->kind);
+		if (fstat(fd, state) != 0)
+			return LRN_POLICY_IO_ERROR;
+		*exists = true;
+		return LRN_POLICY_OK;
+	}
+	if (fstatat(lrn_dirfd(policy, path->kind), path->name, state, AT_SYMLINK_NOFOLLOW) != 0)
+	{
+		if (errno == ENOENT)
+			return LRN_POLICY_OK;
+		return LRN_POLICY_IO_ERROR;
+	}
+	if (!lrn_exact_entry(lrn_dirfd(policy, path->kind), path->name, state))
+		return LRN_POLICY_ACCESS_DENIED;
+	*exists = true;
+	return LRN_POLICY_OK;
+}
+
+static LRN_POLICY_RESULT lrn_scan_dir(const LRN_DRIVE_POLICY* policy, int fd, LRN_SCAN* scan)
+{
+	int copy = openat(fd, ".", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (copy < 0)
+		return LRN_POLICY_IO_ERROR;
+	DIR* directory = fdopendir(copy);
+	if (!directory)
+	{
+		close(copy);
+		return LRN_POLICY_IO_ERROR;
+	}
+	char names[LRN_MAX_FILES + 1][256] = { { 0 } };
+	size_t names_count = 0;
+	LRN_POLICY_RESULT result = LRN_POLICY_OK;
+	errno = 0;
+	for (struct dirent* entry = readdir(directory); entry; entry = readdir(directory))
+	{
+		if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
+			continue;
+		if (!lrn_valid_name(entry->d_name) || names_count >= LRN_MAX_FILES + 1)
+		{
+			result = LRN_POLICY_ACCESS_DENIED;
+			break;
+		}
+		for (size_t x = 0; x < names_count; x++)
+		{
+			if (strcmp(names[x], entry->d_name) != 0 &&
+			    lrn_ascii_equal_fold(names[x], entry->d_name))
+			{
+				result = LRN_POLICY_ACCESS_DENIED;
+				break;
+			}
+		}
+		if (result != LRN_POLICY_OK)
+			break;
+		strncpy(names[names_count++], entry->d_name, sizeof(names[0]) - 1);
+		struct stat state = { 0 };
+		if (fstatat(fd, entry->d_name, &state, AT_SYMLINK_NOFOLLOW) != 0 ||
+		    !S_ISREG(state.st_mode) || state.st_uid != policy->uid || state.st_nlink != 1 ||
+		    (state.st_mode & 07777) != 0600 || state.st_size < 0)
+		{
+			result = LRN_POLICY_ACCESS_DENIED;
+			break;
+		}
+		if ((uint64_t)state.st_size > LRN_MAX_FILE_BYTES ||
+		    !lrn_add_u64(scan->total, (uint64_t)state.st_size, &scan->total))
+		{
+			result = LRN_POLICY_FILE_TOO_LARGE;
+			break;
+		}
+		scan->count++;
+		if (scan->count > LRN_MAX_FILES || scan->total > LRN_MAX_TOTAL_BYTES)
+		{
+			result = LRN_POLICY_DISK_FULL;
+			break;
+		}
+	}
+	if (result == LRN_POLICY_OK && errno != 0)
+		result = LRN_POLICY_IO_ERROR;
+	closedir(directory);
+	return result;
+}
+
+static LRN_POLICY_RESULT lrn_scan(const LRN_DRIVE_POLICY* policy, LRN_SCAN* scan)
+{
+	if (!policy || !scan)
+		return LRN_POLICY_IO_ERROR;
+	memset(scan, 0, sizeof(*scan));
+	LRN_POLICY_RESULT result = lrn_scan_dir(policy, policy->to_fd, scan);
+	if (result == LRN_POLICY_OK)
+		result = lrn_scan_dir(policy, policy->from_fd, scan);
+	return result;
+}
+
+static bool lrn_valid_root_shape(const char* root)
+{
+	static const char marker[] = "/rdp-saf-mirrors-v1/";
+	if (!root || root[0] != '/')
+		return false;
+	const char* found = NULL;
+	for (const char* cursor = strstr(root, marker); cursor; cursor = strstr(cursor + 1, marker))
+		found = cursor;
+	if (!found)
+		return false;
+	const char* digest = found + sizeof(marker) - 1;
+	for (size_t x = 0; x < 32; x++)
+	{
+		if (!((digest[x] >= '0' && digest[x] <= '9') ||
+		      (digest[x] >= 'a' && digest[x] <= 'f')))
+			return false;
+	}
+	return strcmp(digest + 32, "/root") == 0;
+}
+
+static bool lrn_same_inode(const struct stat* left, const struct stat* right);
+
+#if defined(ANDROID)
+static bool lrn_parse_proc_endpoint(const char* endpoint, int* descriptor)
+{
+	static const char prefix[] = "/proc/self/fd/";
+	if (!endpoint || !descriptor || strncmp(endpoint, prefix, sizeof(prefix) - 1) != 0)
+		return false;
+	const char* number = endpoint + sizeof(prefix) - 1;
+	if (*number == '\0' || (number[0] == '0' && number[1] != '\0'))
+		return false;
+	uint64_t value = 0;
+	for (const char* cursor = number; *cursor; cursor++)
+	{
+		if (*cursor < '0' || *cursor > '9' || value > ((uint64_t)INT_MAX / 10U))
+			return false;
+		value = value * 10U + (uint64_t)(*cursor - '0');
+		if (value > INT_MAX)
+			return false;
+	}
+	char canonical[64] = { 0 };
+	const int count = snprintf(canonical, sizeof(canonical), "%s%d", prefix, (int)value);
+	if (count < 1 || (size_t)count >= sizeof(canonical) || strcmp(endpoint, canonical) != 0)
+		return false;
+	*descriptor = (int)value;
+	return true;
+}
+
+static bool lrn_read_proc_target(const char* endpoint, char* target, size_t capacity)
+{
+	if (!endpoint || !target || capacity < 2)
+		return false;
+	const ssize_t length = readlink(endpoint, target, capacity - 1);
+	if (length < 1 || (size_t)length >= capacity - 1)
+		return false;
+	target[length] = '\0';
+	return target[0] == '/' && strstr(target, " (deleted)") == NULL;
+}
+
+static bool lrn_fd_is_controlled_directory(int descriptor)
+{
+	const int flags = fcntl(descriptor, F_GETFL);
+	const int fd_flags = fcntl(descriptor, F_GETFD);
+	return flags >= 0 && fd_flags >= 0 && (flags & O_DIRECTORY) != 0 &&
+	       (flags & O_ACCMODE) != O_WRONLY && (fd_flags & FD_CLOEXEC) != 0;
+}
+
+static bool lrn_resolve_proc_endpoint(const char* endpoint, int* source_fd, int* retained_fd,
+	                                  char* canonical_root, size_t capacity)
+{
+	int descriptor = -1;
+	if (!lrn_parse_proc_endpoint(endpoint, &descriptor) ||
+	    !lrn_fd_is_controlled_directory(descriptor))
+		return false;
+	struct stat first = { 0 };
+	struct stat path = { 0 };
+	struct stat retained = { 0 };
+	struct stat last = { 0 };
+	char target[PATH_MAX] = { 0 };
+	char resolved[PATH_MAX] = { 0 };
+	if (fstat(descriptor, &first) != 0 || !S_ISDIR(first.st_mode) ||
+	    !lrn_read_proc_target(endpoint, target, sizeof(target)) || !realpath(target, resolved) ||
+	    strcmp(target, resolved) != 0 || strlen(resolved) >= capacity ||
+	    lstat(resolved, &path) != 0 || !lrn_same_inode(&first, &path))
+		return false;
+	const int duplicate = fcntl(descriptor, F_DUPFD_CLOEXEC, 0);
+	if (duplicate < 0)
+		return false;
+	char second_target[PATH_MAX] = { 0 };
+	const bool valid = fstat(duplicate, &retained) == 0 && fstat(descriptor, &last) == 0 &&
+	                   lrn_same_inode(&first, &retained) && lrn_same_inode(&first, &last) &&
+	                   lrn_read_proc_target(endpoint, second_target, sizeof(second_target)) &&
+	                   strcmp(second_target, resolved) == 0 && lstat(resolved, &path) == 0 &&
+	                   lrn_same_inode(&first, &path);
+	if (!valid)
+	{
+		close(duplicate);
+		return false;
+	}
+	strcpy(canonical_root, resolved);
+	*source_fd = descriptor;
+	*retained_fd = duplicate;
+	return true;
+}
+#endif
+
+static bool lrn_owned_dir_path(const char* path, uid_t uid)
+{
+	struct stat state = { 0 };
+	return path && lstat(path, &state) == 0 && S_ISDIR(state.st_mode) && state.st_uid == uid &&
+	       (state.st_mode & 07777) == 0700;
+}
+
+static bool lrn_trusted_private_dir_path(const char* path, uid_t uid, gid_t gid)
+{
+	struct stat state = { 0 };
+	return path && lstat(path, &state) == 0 && S_ISDIR(state.st_mode) && state.st_uid == uid &&
+	       state.st_gid == gid && (state.st_mode & 0002) == 0;
+}
+
+static bool lrn_owned_root_chain(const char* root, uid_t uid, gid_t gid)
+{
+	char transfer[PATH_MAX] = { 0 };
+	char base[PATH_MAX] = { 0 };
+	char private_root[PATH_MAX] = { 0 };
+	const size_t root_length = strlen(root);
+	if (root_length < sizeof("/01234567890123456789012345678901/root") - 1 ||
+	    root_length >= sizeof(transfer))
+		return false;
+	memcpy(transfer, root, root_length - sizeof("/root") + 1);
+	if (strlen(transfer) >= sizeof(base))
+		return false;
+	strcpy(base, transfer);
+	char* slash = strrchr(base, '/');
+	if (!slash)
+		return false;
+	*slash = '\0';
+	if (strlen(base) >= sizeof(private_root))
+		return false;
+	strcpy(private_root, base);
+	slash = strrchr(private_root, '/');
+	if (!slash)
+		return false;
+	*slash = '\0';
+	return lrn_trusted_private_dir_path(private_root, uid, gid) && lrn_owned_dir_path(base, uid) &&
+	       lrn_owned_dir_path(transfer, uid) && lrn_owned_dir_path(root, uid);
+}
+
+static bool lrn_same_inode(const struct stat* left, const struct stat* right)
+{
+	return left && right && left->st_dev == right->st_dev && left->st_ino == right->st_ino;
+}
+
+static bool lrn_policy_dirs_current(const LRN_DRIVE_POLICY* policy)
+{
+	if (!policy || !lrn_owned_root_chain(policy->root, policy->uid, policy->gid) ||
+	    !lrn_owned_dir(policy->root_fd, policy->uid) ||
+	    !lrn_owned_dir(policy->to_fd, policy->uid) ||
+	    !lrn_owned_dir(policy->from_fd, policy->uid))
+		return false;
+	struct stat held_root = { 0 };
+	struct stat path_root = { 0 };
+	struct stat held_to = { 0 };
+	struct stat path_to = { 0 };
+	struct stat held_from = { 0 };
+	struct stat path_from = { 0 };
+	if (!(fstat(policy->root_fd, &held_root) == 0 && lstat(policy->root, &path_root) == 0 &&
+	       fstat(policy->to_fd, &held_to) == 0 &&
+	       fstatat(policy->root_fd, "ToRemote", &path_to, AT_SYMLINK_NOFOLLOW) == 0 &&
+	       fstat(policy->from_fd, &held_from) == 0 &&
+	       fstatat(policy->root_fd, "FromRemote", &path_from, AT_SYMLINK_NOFOLLOW) == 0 &&
+	       lrn_same_inode(&held_root, &path_root) && lrn_same_inode(&held_to, &path_to) &&
+	       lrn_same_inode(&held_from, &path_from)))
+		return false;
+#if defined(ANDROID)
+	struct stat source = { 0 };
+	char target[PATH_MAX] = { 0 };
+	if (policy->source_fd < 0 || !lrn_fd_is_controlled_directory(policy->source_fd) ||
+	    fstat(policy->source_fd, &source) != 0 || !lrn_same_inode(&held_root, &source) ||
+	    !lrn_read_proc_target(policy->endpoint, target, sizeof(target)) ||
+	    strcmp(target, policy->root) != 0)
+		return false;
+#endif
+	return true;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_create(const char* drive_name, const char* endpoint,
+                                          LRN_DRIVE_POLICY** out)
+{
+	if (!out)
+		return LRN_POLICY_IO_ERROR;
+	*out = NULL;
+	if (!drive_name || strcmp(drive_name, LRN_DRIVE_NAME) != 0)
+		return LRN_POLICY_INACTIVE;
+	if (!endpoint || strlen(endpoint) >= PATH_MAX)
+		return LRN_POLICY_ACCESS_DENIED;
+	char root[PATH_MAX] = { 0 };
+	int source_fd = -1;
+	int retained_fd = -1;
+#if defined(ANDROID)
+	if (!lrn_resolve_proc_endpoint(endpoint, &source_fd, &retained_fd, root, sizeof(root)))
+		return LRN_POLICY_ACCESS_DENIED;
+#else
+	if (!realpath(endpoint, root) || strcmp(endpoint, root) != 0)
+		return LRN_POLICY_ACCESS_DENIED;
+	retained_fd = open(root, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (retained_fd < 0)
+		return LRN_POLICY_ACCESS_DENIED;
+#endif
+	if (!lrn_valid_root_shape(root))
+	{
+		close(retained_fd);
+		return LRN_POLICY_ACCESS_DENIED;
+	}
+	LRN_DRIVE_POLICY* policy = calloc(1, sizeof(*policy));
+	if (!policy)
+	{
+		close(retained_fd);
+		return LRN_POLICY_IO_ERROR;
+	}
+	policy->source_fd = source_fd;
+	policy->root_fd = retained_fd;
+	policy->to_fd = policy->from_fd = -1;
+	policy->uid = geteuid();
+	policy->gid = getegid();
+	if (!lrn_owned_root_chain(root, policy->uid, policy->gid))
+		goto fail;
+	strncpy(policy->root, root, sizeof(policy->root) - 1);
+	strncpy(policy->endpoint, endpoint, sizeof(policy->endpoint) - 1);
+	if (policy->root_fd < 0 || !lrn_owned_dir(policy->root_fd, policy->uid))
+		goto fail;
+	policy->to_fd = openat(policy->root_fd, "ToRemote", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	policy->from_fd =
+	    openat(policy->root_fd, "FromRemote", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (!lrn_owned_dir(policy->to_fd, policy->uid) || !lrn_owned_dir(policy->from_fd, policy->uid))
+		goto fail;
+	if (pthread_mutex_init(&policy->mutex, NULL) != 0)
+		goto fail;
+	LRN_SCAN scan = { 0 };
+	if (lrn_scan(policy, &scan) != LRN_POLICY_OK)
+	{
+		pthread_mutex_destroy(&policy->mutex);
+		goto fail;
+	}
+	*out = policy;
+	return LRN_POLICY_OK;
+
+fail:
+	if (policy->from_fd >= 0)
+		close(policy->from_fd);
+	if (policy->to_fd >= 0)
+		close(policy->to_fd);
+	if (policy->root_fd >= 0)
+		close(policy->root_fd);
+	free(policy);
+	return LRN_POLICY_ACCESS_DENIED;
+}
+
+void lrn_drive_policy_free(LRN_DRIVE_POLICY* policy)
+{
+	if (!policy)
+		return;
+	pthread_mutex_destroy(&policy->mutex);
+	close(policy->from_fd);
+	close(policy->to_fd);
+	close(policy->root_fd);
+	memset(policy, 0, sizeof(*policy));
+	free(policy);
+}
+
+bool lrn_drive_policy_active(const LRN_DRIVE_POLICY* policy)
+{
+	return policy != NULL;
+}
+
+bool lrn_drive_policy_terminal(LRN_DRIVE_POLICY* policy)
+{
+	if (!policy || pthread_mutex_lock(&policy->mutex) != 0)
+		return policy != NULL;
+	const bool terminal = policy->poisoned;
+	pthread_mutex_unlock(&policy->mutex);
+	return terminal;
+}
+
+static LRN_POLICY_RESULT lrn_guard_begin(LRN_DRIVE_POLICY* policy, LRN_MUTATION_KIND kind,
+	                                      const LRN_PATH* source, const LRN_PATH* target,
+	                                      LRN_POLICY_GUARD* guard, LRN_SCAN* scan)
+{
+	if (!policy || !source || !guard || !scan)
+		return LRN_POLICY_IO_ERROR;
+	memset(guard, 0, sizeof(*guard));
+	if (pthread_mutex_lock(&policy->mutex) != 0)
+		return LRN_POLICY_IO_ERROR;
+	guard->locked = true;
+	guard->policy = policy;
+	guard->kind = kind;
+	if (policy->poisoned)
+		return LRN_POLICY_TERMINAL;
+	if (!lrn_policy_dirs_current(policy))
+	{
+		policy->poisoned = true;
+		return LRN_POLICY_TERMINAL;
+	}
+	LRN_POLICY_RESULT result = lrn_scan(policy, scan);
+	if (result != LRN_POLICY_OK)
+	{
+		policy->poisoned = true;
+		return LRN_POLICY_TERMINAL;
+	}
+	guard->count_before = scan->count;
+	guard->total_before = scan->total;
+	strncpy(guard->source, source->relative, sizeof(guard->source) - 1);
+	if (target)
+		strncpy(guard->target, target->relative, sizeof(guard->target) - 1);
+	struct stat state = { 0 };
+	result = lrn_stat_path(policy, source, &state, &guard->source_existed);
+	if (result != LRN_POLICY_OK)
+		return result;
+	if (guard->source_existed)
+		guard->source_inode = (uint64_t)state.st_ino;
+	if (target)
+	{
+		result = lrn_stat_path(policy, target, &state, &guard->target_existed);
+		if (result != LRN_POLICY_OK)
+			return result;
+		if (guard->target_existed)
+			guard->target_inode = (uint64_t)state.st_ino;
+	}
+	return LRN_POLICY_OK;
+}
+
+static void lrn_guard_unlock(LRN_POLICY_GUARD* guard)
+{
+	if (guard && guard->locked)
+	{
+		pthread_mutex_unlock(&guard->policy->mutex);
+		guard->locked = false;
+	}
+}
+
+static LRN_POLICY_RESULT lrn_guard_fail(LRN_POLICY_GUARD* guard, LRN_POLICY_RESULT result)
+{
+	lrn_guard_unlock(guard);
+	return result;
+}
+
+static LRN_POLICY_RESULT lrn_projection(const LRN_SCAN* scan, uint64_t old_size,
+	                                     bool existed, uint64_t new_size, bool may_create)
+{
+	if (new_size > LRN_MAX_FILE_BYTES)
+		return LRN_POLICY_FILE_TOO_LARGE;
+	uint64_t count = scan->count + ((!existed && may_create) ? 1U : 0U);
+	if (count > LRN_MAX_FILES || scan->total < old_size)
+		return LRN_POLICY_DISK_FULL;
+	uint64_t total = scan->total - old_size;
+	if (!lrn_add_u64(total, new_size, &total) || total > LRN_MAX_TOTAL_BYTES)
+		return LRN_POLICY_DISK_FULL;
+	return LRN_POLICY_OK;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_begin_create(LRN_DRIVE_POLICY* policy, const char* relative,
+	                                              bool write_requested, bool may_create,
+	                                              bool truncates, bool directory_requested,
+	                                              uint64_t allocation_size,
+	                                              LRN_POLICY_GUARD* guard)
+{
+	LRN_PATH path = { 0 };
+	LRN_POLICY_RESULT result = lrn_parse_relative(relative, &path);
+	if (result != LRN_POLICY_OK)
+		return result;
+	LRN_SCAN scan = { 0 };
+	result = lrn_guard_begin(policy, LRN_MUTATION_CREATE, &path, NULL, guard, &scan);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	if (!path.file)
+	{
+		if (write_requested || truncates || allocation_size != 0 || !guard->source_existed)
+			return lrn_guard_fail(guard, LRN_POLICY_ACCESS_DENIED);
+		return LRN_POLICY_OK;
+	}
+	if (directory_requested)
+		return lrn_guard_fail(guard, LRN_POLICY_ACCESS_DENIED);
+	if (path.kind == LRN_PATH_TO_REMOTE &&
+	    (write_requested || may_create || truncates || allocation_size != 0))
+		return lrn_guard_fail(guard, LRN_POLICY_ACCESS_DENIED);
+	result = lrn_no_name_alias(policy, &path);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	struct stat state = { 0 };
+	bool exists = false;
+	result = lrn_stat_path(policy, &path, &state, &exists);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	const uint64_t old_size = exists && S_ISREG(state.st_mode) ? (uint64_t)state.st_size : 0;
+	uint64_t projected = truncates ? 0 : old_size;
+	if (allocation_size > projected)
+		projected = allocation_size;
+	result = lrn_projection(&scan, old_size, exists, projected, may_create);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	return LRN_POLICY_OK;
+}
+
+static LRN_POLICY_RESULT lrn_begin_existing(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                          LRN_MUTATION_KIND kind, LRN_POLICY_GUARD* guard,
+	                                          LRN_PATH* path, LRN_SCAN* scan, struct stat* state)
+{
+	LRN_POLICY_RESULT result = lrn_parse_fullpath(policy, fullpath, path);
+	if (result != LRN_POLICY_OK || !path->file || path->kind != LRN_PATH_FROM_REMOTE)
+		return result == LRN_POLICY_OK ? LRN_POLICY_ACCESS_DENIED : result;
+	result = lrn_guard_begin(policy, kind, path, NULL, guard, scan);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	bool exists = false;
+	result = lrn_stat_path(policy, path, state, &exists);
+	if (result != LRN_POLICY_OK || !exists || !S_ISREG(state->st_mode))
+		return lrn_guard_fail(guard, result == LRN_POLICY_OK ? LRN_POLICY_ACCESS_DENIED : result);
+	return LRN_POLICY_OK;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_begin_write(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                             uint64_t offset, uint64_t length,
+	                                             LRN_POLICY_GUARD* guard)
+{
+	LRN_PATH path = { 0 };
+	LRN_SCAN scan = { 0 };
+	struct stat state = { 0 };
+	LRN_POLICY_RESULT result =
+	    lrn_begin_existing(policy, fullpath, LRN_MUTATION_WRITE, guard, &path, &scan, &state);
+	if (result != LRN_POLICY_OK)
+		return result;
+	uint64_t end = 0;
+	if (!lrn_add_u64(offset, length, &end))
+		return lrn_guard_fail(guard, LRN_POLICY_FILE_TOO_LARGE);
+	const uint64_t projected = end > (uint64_t)state.st_size ? end : (uint64_t)state.st_size;
+	result = lrn_projection(&scan, (uint64_t)state.st_size, true, projected, false);
+	return result == LRN_POLICY_OK ? result : lrn_guard_fail(guard, result);
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_begin_resize(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                              int64_t size, LRN_POLICY_GUARD* guard)
+{
+	if (size < 0)
+		return LRN_POLICY_INVALID_NAME;
+	LRN_PATH path = { 0 };
+	LRN_SCAN scan = { 0 };
+	struct stat state = { 0 };
+	LRN_POLICY_RESULT result =
+	    lrn_begin_existing(policy, fullpath, LRN_MUTATION_RESIZE, guard, &path, &scan, &state);
+	if (result != LRN_POLICY_OK)
+		return result;
+	result = lrn_projection(&scan, (uint64_t)state.st_size, true, (uint64_t)size, false);
+	return result == LRN_POLICY_OK ? result : lrn_guard_fail(guard, result);
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_begin_rename(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                              const char* target_relative, bool replace,
+	                                              LRN_POLICY_GUARD* guard)
+{
+	LRN_PATH source = { 0 };
+	LRN_PATH target = { 0 };
+	LRN_POLICY_RESULT result = lrn_parse_fullpath(policy, fullpath, &source);
+	if (result != LRN_POLICY_OK || !source.file || source.kind != LRN_PATH_FROM_REMOTE)
+		return result == LRN_POLICY_OK ? LRN_POLICY_ACCESS_DENIED : result;
+	result = lrn_parse_relative(target_relative, &target);
+	if (result != LRN_POLICY_OK || !target.file || target.kind != LRN_PATH_FROM_REMOTE)
+		return result == LRN_POLICY_OK ? LRN_POLICY_ACCESS_DENIED : result;
+	if (strcmp(source.name, target.name) != 0 && lrn_ascii_equal_fold(source.name, target.name))
+		return LRN_POLICY_ACCESS_DENIED;
+	LRN_SCAN scan = { 0 };
+	result = lrn_guard_begin(policy, LRN_MUTATION_RENAME, &source, &target, guard, &scan);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	if (!guard->source_existed)
+		return lrn_guard_fail(guard, LRN_POLICY_ACCESS_DENIED);
+	result = lrn_no_name_alias(policy, &target);
+	if (result != LRN_POLICY_OK)
+		return lrn_guard_fail(guard, result);
+	if (guard->target_existed && !replace && strcmp(source.name, target.name) != 0)
+		return lrn_guard_fail(guard, LRN_POLICY_ACCESS_DENIED);
+	return LRN_POLICY_OK;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_begin_metadata(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                                bool deleting, LRN_POLICY_GUARD* guard)
+{
+	(void)deleting;
+	LRN_PATH path = { 0 };
+	LRN_SCAN scan = { 0 };
+	struct stat state = { 0 };
+	return lrn_begin_existing(policy, fullpath, LRN_MUTATION_METADATA, guard, &path, &scan, &state);
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_begin_delete(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                              LRN_POLICY_GUARD* guard)
+{
+	LRN_PATH path = { 0 };
+	LRN_SCAN scan = { 0 };
+	struct stat state = { 0 };
+	return lrn_begin_existing(policy, fullpath, LRN_MUTATION_DELETE, guard, &path, &scan, &state);
+}
+
+static LRN_POLICY_RESULT lrn_verify_relative(LRN_POLICY_GUARD* guard, const char* relative,
+	                                           const LRN_HANDLE_INFO* handle, bool enforce_mode)
+{
+	LRN_PATH path = { 0 };
+	LRN_POLICY_RESULT result = lrn_parse_relative(relative, &path);
+	if (result != LRN_POLICY_OK)
+		return result;
+	if (!path.file)
+	{
+		struct stat state = { 0 };
+		const int fd = lrn_dirfd(guard->policy, path.kind);
+		if (fstat(fd, &state) != 0 || !lrn_owned_dir(fd, guard->policy->uid) || !handle ||
+		    !handle->valid || !handle->directory || handle->volume != (uint32_t)state.st_dev ||
+		    handle->inode != (uint32_t)state.st_ino)
+			return LRN_POLICY_ACCESS_DENIED;
+		return LRN_POLICY_OK;
+	}
+	const int fd = openat(lrn_dirfd(guard->policy, path.kind), path.name,
+	                      O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return LRN_POLICY_ACCESS_DENIED;
+	if (enforce_mode && fchmod(fd, 0600) != 0)
+	{
+		close(fd);
+		return LRN_POLICY_IO_ERROR;
+	}
+	struct stat state = { 0 };
+	const int status = fstat(fd, &state);
+	close(fd);
+	if (status != 0 || !S_ISREG(state.st_mode) || state.st_uid != guard->policy->uid ||
+	    state.st_nlink != 1 || (state.st_mode & 07777) != 0600 || state.st_size < 0 ||
+	    !handle || !handle->valid || handle->directory || handle->links != 1 ||
+	    handle->volume != (uint32_t)state.st_dev || handle->inode != (uint32_t)state.st_ino ||
+	    handle->size != (uint64_t)state.st_size)
+		return LRN_POLICY_ACCESS_DENIED;
+	return LRN_POLICY_OK;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_verify_handle(LRN_POLICY_GUARD* guard,
+	                                               const LRN_HANDLE_INFO* handle,
+	                                               bool enforce_mode)
+{
+	if (!guard || !guard->locked)
+		return LRN_POLICY_IO_ERROR;
+	const char* relative = guard->kind == LRN_MUTATION_RENAME && guard->target[0]
+	                           ? guard->target
+	                           : guard->source;
+	return lrn_verify_relative(guard, relative, handle, enforce_mode);
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_verify_source_handle(LRN_POLICY_GUARD* guard,
+	                                                      const LRN_HANDLE_INFO* handle,
+	                                                      bool enforce_mode)
+{
+	if (!guard || !guard->locked)
+		return LRN_POLICY_IO_ERROR;
+	return lrn_verify_relative(guard, guard->source, handle, enforce_mode);
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_validate_read(LRN_DRIVE_POLICY* policy, const char* fullpath,
+	                                               const LRN_HANDLE_INFO* handle)
+{
+	LRN_PATH path = { 0 };
+	LRN_POLICY_RESULT result = lrn_parse_fullpath(policy, fullpath, &path);
+	if (result != LRN_POLICY_OK)
+		return result;
+	if (pthread_mutex_lock(&policy->mutex) != 0)
+		return LRN_POLICY_IO_ERROR;
+	if (policy->poisoned || !lrn_policy_dirs_current(policy))
+	{
+		policy->poisoned = true;
+		pthread_mutex_unlock(&policy->mutex);
+		return LRN_POLICY_TERMINAL;
+	}
+	LRN_SCAN scan = { 0 };
+	if (lrn_scan(policy, &scan) != LRN_POLICY_OK)
+	{
+		policy->poisoned = true;
+		pthread_mutex_unlock(&policy->mutex);
+		return LRN_POLICY_TERMINAL;
+	}
+	LRN_POLICY_GUARD guard = { .policy = policy, .locked = true };
+	strncpy(guard.source, path.relative, sizeof(guard.source) - 1);
+	result = lrn_verify_relative(&guard, guard.source, handle, false);
+	guard.locked = false;
+	pthread_mutex_unlock(&policy->mutex);
+	return result;
+}
+
+static bool lrn_same_state(LRN_POLICY_GUARD* guard)
+{
+	LRN_PATH source = { 0 };
+	LRN_PATH target = { 0 };
+	struct stat state = { 0 };
+	bool exists = false;
+	if (lrn_parse_relative(guard->source, &source) != LRN_POLICY_OK ||
+	    lrn_stat_path(guard->policy, &source, &state, &exists) != LRN_POLICY_OK ||
+	    exists != guard->source_existed ||
+	    (exists && (uint64_t)state.st_ino != guard->source_inode))
+		return false;
+	if (guard->target[0])
+	{
+		if (lrn_parse_relative(guard->target, &target) != LRN_POLICY_OK ||
+		    lrn_stat_path(guard->policy, &target, &state, &exists) != LRN_POLICY_OK ||
+		    exists != guard->target_existed ||
+		    (exists && (uint64_t)state.st_ino != guard->target_inode))
+			return false;
+	}
+	return true;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_finish(LRN_POLICY_GUARD* guard, bool mutation_succeeded,
+	                                        const LRN_HANDLE_INFO* handle)
+{
+	if (!guard || !guard->locked || !guard->policy)
+		return LRN_POLICY_IO_ERROR;
+	LRN_POLICY_RESULT result = LRN_POLICY_OK;
+	LRN_SCAN scan = { 0 };
+	if (!mutation_succeeded)
+		result = LRN_POLICY_TERMINAL;
+	else
+	{
+		result = lrn_scan(guard->policy, &scan);
+		if (result == LRN_POLICY_OK && guard->kind == LRN_MUTATION_DELETE)
+		{
+			LRN_PATH source = { 0 };
+			struct stat state = { 0 };
+			bool exists = false;
+			if (lrn_parse_relative(guard->source, &source) != LRN_POLICY_OK ||
+			    lrn_stat_path(guard->policy, &source, &state, &exists) != LRN_POLICY_OK || exists)
+				result = LRN_POLICY_TERMINAL;
+		}
+		else if (result == LRN_POLICY_OK)
+			result = lrn_drive_policy_verify_handle(guard, handle, true);
+	}
+	if (result != LRN_POLICY_OK)
+		guard->policy->poisoned = true;
+	lrn_guard_unlock(guard);
+	return result;
+}
+
+LRN_POLICY_RESULT lrn_drive_policy_abort(LRN_POLICY_GUARD* guard)
+{
+	if (!guard || !guard->locked || !guard->policy)
+		return LRN_POLICY_IO_ERROR;
+	LRN_SCAN scan = { 0 };
+	LRN_POLICY_RESULT result = lrn_scan(guard->policy, &scan);
+	if (result != LRN_POLICY_OK || scan.count != guard->count_before ||
+	    scan.total != guard->total_before || !lrn_same_state(guard))
+	{
+		guard->policy->poisoned = true;
+		result = LRN_POLICY_TERMINAL;
+	}
+	lrn_guard_unlock(guard);
+	return result;
+}
diff --git a/channels/drive/client/drive_larenor.h b/channels/drive/client/drive_larenor.h
new file mode 100644
index 0000000..0cee207
