+	const LRN_POLICY_RESULT result =
+	    fullpath && drive_larenor_handle_info(file, &info)
+	        ? lrn_drive_policy_validate_read(drive->larenor, fullpath, &info)
+	        : LRN_POLICY_IO_ERROR;
+	free(fullpath);
+	return result;
