+/* Capture the application-owned base independently of any provider URI. */
+static char* android_no_backup_root(JNIEnv* env, jobject context)
+{
+	jclass contextClass = (*env)->GetObjectClass(env, context);
+	if (!contextClass || (*env)->ExceptionCheck(env))
+		return nullptr;
+	jmethodID directoryMethod = (*env)->GetMethodID(
+	    env, contextClass, "getNoBackupFilesDir", "()Ljava/io/File;");
+	jobject directory = directoryMethod ? (*env)->CallObjectMethod(env, context, directoryMethod)
+	                                  : nullptr;
+	jclass fileClass = directory ? (*env)->GetObjectClass(env, directory) : nullptr;
+	jmethodID pathMethod = fileClass ? (*env)->GetMethodID(
+	    env, fileClass, "getCanonicalPath", "()Ljava/lang/String;") : nullptr;
+	jstring path = pathMethod ? (*env)->CallObjectMethod(env, directory, pathMethod) : nullptr;
+	char* result = nullptr;
+	if (path && !(*env)->ExceptionCheck(env))
+	{
+		const char* raw = (*env)->GetStringUTFChars(env, path, nullptr);
+		if (raw)
+		{
+			char canonical[PATH_MAX];
+			struct stat info;
+			if (realpath(raw, canonical) && strcmp(raw, canonical) == 0 &&
+			    lstat(canonical, &info) == 0 && S_ISDIR(info.st_mode) &&
+			    info.st_uid == getuid() && info.st_gid == getgid() && (info.st_mode & 0002) == 0)
+				result = _strdup(canonical);
+			(*env)->ReleaseStringUTFChars(env, path, raw);
+		}
+	}
+	if (path) (*env)->DeleteLocalRef(env, path);
+	if (fileClass) (*env)->DeleteLocalRef(env, fileClass);
+	if (directory) (*env)->DeleteLocalRef(env, directory);
+	(*env)->DeleteLocalRef(env, contextClass);
+	return result;
+}
