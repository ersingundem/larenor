+++ b/channels/drive/client/drive_larenor.h
@@ -0,0 +1,98 @@
+#ifndef FREERDP_CHANNEL_DRIVE_LARENOR_H
+#define FREERDP_CHANNEL_DRIVE_LARENOR_H
