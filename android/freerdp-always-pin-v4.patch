+static int android_verify_x509_certificate(freerdp* instance, const BYTE* data, size_t length,
+                                           const char* host, UINT16 port, DWORD flags)
+{
+	if (!instance || !data || (length == 0) || (length > INT32_MAX) || !host)
+		return 0;
+
+	JNIEnv* env;
+	jboolean attached = jni_attach_thread(&env);
+	jbyteArray jpem = (*env)->NewByteArray(env, (jsize)length);
+	jstring jhost = (*env)->NewStringUTF(env, host);
+	if (!jpem || !jhost)
+	{
+		if (attached == JNI_TRUE)
+			jni_detach_thread();
+		return 0;
+	}
+	(*env)->SetByteArrayRegion(env, jpem, 0, (jsize)length, (const jbyte*)data);
+	jint res = freerdp_callback_int_result(
+	    "OnVerifyX509Certificate", "(J[BLjava/lang/String;JJ)I", (jlong)instance, jpem, jhost,
+	    (jlong)port, (jlong)flags);
+	(*env)->DeleteLocalRef(env, jpem);
+	(*env)->DeleteLocalRef(env, jhost);
+
+	if (attached == JNI_TRUE)
+		jni_detach_thread();
+	return res > 0 ? 1 : 0;
+}
