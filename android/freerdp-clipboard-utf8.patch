+#define ANDROID_CLIPBOARD_TEXT_MAX_BYTES (64U * 1024U)
+
+static BOOL android_copy_clipboard_utf16(const jchar* chars, jsize length, WCHAR* wide)
+{
+	if (!chars || !wide || (length <= 0))
+		return FALSE;
+
+	for (jsize x = 0; x < length; x++)
+	{
+		const jchar value = chars[x];
+		if (value == 0)
+			return FALSE;
+		if ((value >= 0xD800U) && (value <= 0xDBFFU))
+		{
+			if ((x + 1 >= length) || (chars[x + 1] < 0xDC00U) ||
+			    (chars[x + 1] > 0xDFFFU))
+				return FALSE;
+			wide[x] = (WCHAR)value;
+			x++;
+			wide[x] = (WCHAR)chars[x];
+			continue;
+		}
+		if ((value >= 0xDC00U) && (value <= 0xDFFFU))
+			return FALSE;
+		wide[x] = (WCHAR)value;
+	}
+	return TRUE;
 }
 
