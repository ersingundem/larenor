 } rdpsndopenslesPlugin;
 
+#define LARENOR_JS_SAFE_COUNTER_MAX 9007199254740991ULL
+
+static void rdpsnd_opensles_publish(rdpsndopenslesPlugin* opensles, BOOL deviceOpen,
+                                    UINT64 acceptedCount, UINT64 completedCount,
+                                    UINT32 fixedState)
+{
+	rdpContext* context = freerdp_rdpsnd_get_context(opensles->device.rdpsnd);
+	if (!context || !context->pubSub)
+		return;
+
+	RemoteAudioPlaybackEventArgs event = WINPR_C_ARRAY_INIT;
+	EventArgsInit(&event, "rdpsnd-opensles");
+	event.deviceOpen = deviceOpen;
+	event.acceptedCount = acceptedCount;
+	event.completedCount = completedCount;
+	event.fixedState = fixedState;
+	(void)PubSub_OnRemoteAudioPlayback(context->pubSub, context, &event);
+}
+
+static void rdpsnd_opensles_observe(void* context, UINT32 fixedState)
+{
+	rdpsndopenslesPlugin* opensles = (rdpsndopenslesPlugin*)context;
+	BOOL publish = FALSE;
+	BOOL failChannel = FALSE;
+	BOOL deviceOpen = FALSE;
+	UINT64 acceptedCount = 0;
+	UINT64 completedCount = 0;
+	UINT32 publishedState = fixedState;
+
+	if (!opensles || !opensles->observerLockInitialized)
+		return;
+
+	EnterCriticalSection(&opensles->observerLock);
+	switch (fixedState)
+	{
+		case FREERDP_REMOTE_AUDIO_DEVICE_OPENED:
+			if (!opensles->failed)
+			{
+				opensles->deviceOpen = TRUE;
+				publish = TRUE;
+			}
+			break;
+		case FREERDP_REMOTE_AUDIO_BUFFER_ACCEPTED:
+			if (!opensles->failed && opensles->deviceOpen)
+			{
+				if (opensles->acceptedCount >= LARENOR_JS_SAFE_COUNTER_MAX)
+				{
+					opensles->failed = TRUE;
+					opensles->deviceOpen = FALSE;
+					publishedState = FREERDP_REMOTE_AUDIO_FAILED;
+					failChannel = TRUE;
+				}
+				else
+					opensles->acceptedCount++;
+				publish = TRUE;
+			}
+			break;
+		case FREERDP_REMOTE_AUDIO_BUFFER_COMPLETED:
+			if (!opensles->failed && opensles->deviceOpen)
+			{
+				if ((opensles->completedCount >= LARENOR_JS_SAFE_COUNTER_MAX) ||
+				    (opensles->completedCount >= opensles->acceptedCount))
+				{
+					opensles->failed = TRUE;
+					opensles->deviceOpen = FALSE;
+					publishedState = FREERDP_REMOTE_AUDIO_FAILED;
+					failChannel = TRUE;
+				}
+				else
+					opensles->completedCount++;
+				publish = TRUE;
+			}
+			break;
+		case FREERDP_REMOTE_AUDIO_DEVICE_CLOSED:
+			if (!opensles->failed)
+			{
+				opensles->deviceOpen = FALSE;
+				publish = TRUE;
+			}
+			break;
+		case FREERDP_REMOTE_AUDIO_FAILED:
+			if (!opensles->failed)
+			{
+				opensles->failed = TRUE;
+				opensles->deviceOpen = FALSE;
+				publish = TRUE;
+				failChannel = TRUE;
+			}
+			break;
+		default:
+			break;
+	}
+	deviceOpen = opensles->deviceOpen;
+	acceptedCount = opensles->acceptedCount;
+	completedCount = opensles->completedCount;
+	if (publish)
+		rdpsnd_opensles_publish(opensles, deviceOpen, acceptedCount, completedCount,
+		                        publishedState);
+	LeaveCriticalSection(&opensles->observerLock);
+
+	if (failChannel)
+	{
+		rdpContext* rdpContext = freerdp_rdpsnd_get_context(opensles->device.rdpsnd);
+		if (rdpContext)
+			setChannelError(rdpContext, ERROR_INTERNAL_ERROR,
+			                "OpenSL playback lifecycle failed");
+	}
+}
