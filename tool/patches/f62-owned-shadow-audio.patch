+static void write_audio_witness(LarenorOwnedChannels* state)
+{
+	BYTE data[64] = { 0 };
+	memcpy(data, "LRNF62A1", 8U);
+	EnterCriticalSection(&state->lock);
+	write_uint32_le(data, 8U, 1U);
+	write_uint32_le(data, 12U, sizeof(data));
+	write_uint32_le(data, 16U, state->ordinal);
+	write_uint32_le(data, 20U, state->audioFlags);
+	write_uint32_le(data, 24U, state->audioActivations);
+	write_uint32_le(data, 28U, state->audioArmRecords);
+	write_uint32_le(data, 32U, state->audioSendCalls);
+	write_uint32_le(data, 36U, state->audioSendAccepted);
+	write_uint32_le(data, 40U, state->audioWaveConfirms);
+	write_uint32_le(data, 44U, state->audioFrames);
+	write_uint32_le(data, 48U, state->audioErrors);
+	LeaveCriticalSection(&state->lock);
+
+	const int fd = open(state->audioWitnessPath, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return;
+	size_t offset = 0;
+	while (offset < sizeof(data))
+	{
+		const ssize_t written = write(fd, &data[offset], sizeof(data) - offset);
+		if (written <= 0)
+			break;
+		offset += (size_t)written;
+	}
+	if (offset == sizeof(data))
+		(void)fsync(fd);
+	(void)close(fd);
+}
