+static void record_audio_error(LarenorOwnedChannels* state)
+{
+	if (state->audioErrors < LARENOR_MAX_CHANNEL_EVENTS)
+		state->audioErrors++;
+}
+
+static DWORD WINAPI audio_worker(LPVOID argument)
+{
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)argument;
+	BYTE arm[LARENOR_AUDIO_ARM_SIZE + 1U] = { 0 };
+	size_t armLength = 0;
+	for (;;)
+	{
+		EnterCriticalSection(&state->lock);
+		const BOOL stopping = state->audioStopping;
+		LeaveCriticalSection(&state->lock);
+		if (stopping)
+			return 0;
+
+		struct pollfd descriptor = { .fd = state->audioArmFd, .events = POLLIN | POLLHUP };
+		const int status = poll(&descriptor, 1, LARENOR_AUDIO_POLL_MILLISECONDS);
+		if (status < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			EnterCriticalSection(&state->lock);
+			record_audio_error(state);
+			LeaveCriticalSection(&state->lock);
+			return 0;
+		}
+		if (status == 0)
+			continue;
+		const ssize_t received = read(state->audioArmFd, &arm[armLength], sizeof(arm) - armLength);
+		if (received < 0)
+		{
+			if ((errno == EAGAIN) || (errno == EWOULDBLOCK) || (errno == EINTR))
+				continue;
+			EnterCriticalSection(&state->lock);
+			record_audio_error(state);
+			LeaveCriticalSection(&state->lock);
+			return 0;
+		}
+		if (received == 0)
+		{
+			EnterCriticalSection(&state->lock);
+			if (armLength != LARENOR_AUDIO_ARM_SIZE)
+				record_audio_error(state);
+			LeaveCriticalSection(&state->lock);
+			break;
+		}
+		armLength += (size_t)received;
+		if (armLength > LARENOR_AUDIO_ARM_SIZE)
+		{
+			EnterCriticalSection(&state->lock);
+			record_audio_error(state);
+			LeaveCriticalSection(&state->lock);
+			return 0;
+		}
+		/* A valid arm is an exact record followed by EOF.  Continue polling so
+		 * a separately written trailing byte cannot be accepted as a record. */
+	}
+
+	EnterCriticalSection(&state->lock);
+	const BOOL exact = (armLength == LARENOR_AUDIO_ARM_SIZE) &&
+	                   (memcmp(arm, "LRNAUD01", 8U) == 0) &&
+	                   (memcmp(&arm[8], state->audioNonce, 64U) == 0);
+	if (!exact || state->audioArmRecords != 0U)
+	{
+		record_audio_error(state);
+		LeaveCriticalSection(&state->lock);
+		return 0;
+	}
+	state->audioArmRecords = 1U;
+	state->audioFlags |= LARENOR_AUDIO_FLAG_ARMED;
+	LeaveCriticalSection(&state->lock);
+
+	RdpsndServerContext* context = nullptr;
+	for (;;)
+	{
+		EnterCriticalSection(&state->lock);
+		const BOOL stopping = state->audioStopping;
+		if (state->audioActivated)
+			context = state->audioContext;
+		LeaveCriticalSection(&state->lock);
+		if (stopping || context)
+			break;
+		Sleep(LARENOR_AUDIO_POLL_MILLISECONDS);
+	}
+	if (!context)
+		return 0;
+
+	INT16 samples[LARENOR_AUDIO_FRAMES * 2U] = { 0 };
+	for (size_t index = 0; index < ARRAYSIZE(samples); index += 2U)
+	{
+		const INT16 value = ((index / 2U) % 44U < 22U) ? 4096 : -4096;
+		samples[index] = value;
+		samples[index + 1U] = value;
+	}
+	EnterCriticalSection(&state->lock);
+	state->audioSendCalls = 1U;
+	LeaveCriticalSection(&state->lock);
+	const UINT rc = context->SendSamples(context, samples, LARENOR_AUDIO_FRAMES, 1U);
+	SecureZeroMemory(samples, sizeof(samples));
+	EnterCriticalSection(&state->lock);
+	if (rc == CHANNEL_RC_OK)
+	{
+		state->audioSendAccepted = 1U;
+		state->audioFrames = LARENOR_AUDIO_FRAMES;
+		state->audioFlags |= LARENOR_AUDIO_FLAG_SEND_ACCEPTED;
+	}
+	else
+		record_audio_error(state);
+	LeaveCriticalSection(&state->lock);
+	return 0;
+}
+
+void shadow_larenor_audio_activated(rdpShadowClient* client, RdpsndServerContext* context)
+{
+	if (!client || !context || !client->larenorOwnedChannels)
+		return;
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)client->larenorOwnedChannels;
+	EnterCriticalSection(&state->lock);
+	if (state->audioStopping || (state->ordinal != 1U) ||
+	    (state->audioActivations != 0U) ||
+	    !context->src_format ||
+	    (context->src_format->wFormatTag != WAVE_FORMAT_PCM) ||
+	    (context->src_format->nChannels != 2U) ||
+	    (context->src_format->nSamplesPerSec != 44100U) ||
+	    (context->src_format->wBitsPerSample != 16U))
+	{
+		record_audio_error(state);
+		LeaveCriticalSection(&state->lock);
+		return;
+	}
+	state->audioActivations = 1U;
+	state->audioActivated = TRUE;
+	state->audioContext = context;
+	state->audioFlags |= LARENOR_AUDIO_FLAG_ACTIVATED;
+	LeaveCriticalSection(&state->lock);
+}
+
+void shadow_larenor_audio_confirmed(rdpShadowClient* client)
+{
+	if (!client || !client->larenorOwnedChannels)
+		return;
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)client->larenorOwnedChannels;
+	EnterCriticalSection(&state->lock);
+	increment_bounded(&state->audioWaveConfirms, &state->audioErrors);
+	LeaveCriticalSection(&state->lock);
+}
+
+void shadow_larenor_audio_stop(rdpShadowClient* client)
+{
+	if (!client || !client->larenorOwnedChannels)
+		return;
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)client->larenorOwnedChannels;
+	EnterCriticalSection(&state->lock);
+	state->audioStopping = TRUE;
+	LeaveCriticalSection(&state->lock);
+	if (state->audioThread)
+	{
+		(void)WaitForSingleObject(state->audioThread, INFINITE);
+		(void)CloseHandle(state->audioThread);
+		state->audioThread = nullptr;
+	}
+}
