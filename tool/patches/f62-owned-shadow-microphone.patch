+/* Private host proof: actual AUDIN data, never device-open/submission alone. */
+static void microphone_arm(LarenorOwnedChannels* state)
+{
+	if (state->ordinal != 1U || state->microphoneArmFd < 0 ||
+	    state->microphoneErrors != 0U || (state->microphoneFlags & 1U))
+		return;
+	for (;;)
+	{
+		const ssize_t count = read(state->microphoneArmFd,
+		    &state->microphoneArm[state->microphoneArmLength],
+		    sizeof(state->microphoneArm) - state->microphoneArmLength);
+		if (count < 0)
+		{
+			if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
+				return;
+			state->microphoneErrors = 1U;
+			break;
+		}
+		if (count == 0)
+		{
+			if (state->microphoneArmLength == 72U &&
+			    memcmp(state->microphoneArm, "LRNMIC01", 8U) == 0 &&
+			    memcmp(&state->microphoneArm[8], state->audioNonce, 64U) == 0 &&
+			    state->microphonePreArmNonzero == 0U)
+				state->microphoneFlags |= 1U;
+			else
+				state->microphoneErrors = 1U;
+			break;
+		}
+		state->microphoneArmLength += (size_t)count;
+		if (state->microphoneArmLength > 72U)
+		{
+			state->microphoneErrors = 1U;
+			break;
+		}
+	}
+	(void)close(state->microphoneArmFd);
+	state->microphoneArmFd = -1;
+	SecureZeroMemory(state->microphoneArm, sizeof(state->microphoneArm));
+}
+
+void shadow_larenor_microphone_data(rdpShadowClient* client,
+    const AUDIO_FORMAT* format, const wStream* samples)
+{
+	if (!client || !client->larenorOwnedChannels)
+		return;
+	LarenorOwnedChannels* state = client->larenorOwnedChannels;
+	EnterCriticalSection(&state->lock);
+	microphone_arm(state);
+	const size_t size = samples ? Stream_GetRemainingLength(samples) : 0U;
+	if (!format || !samples || format->wFormatTag != WAVE_FORMAT_PCM ||
+	    format->nChannels != 2U || format->nSamplesPerSec != 44100U ||
+	    format->wBitsPerSample != 16U || format->nBlockAlign != 4U ||
+	    size < 128U || size > 16384U || size % 4U != 0U ||
+	    state->microphonePackets >= 60000U)
+	{
+		state->microphoneErrors = 1U;
+		LeaveCriticalSection(&state->lock);
+		return;
+	}
+	state->microphonePackets++;
+	const BYTE* data = Stream_Pointer(samples);
+	const size_t frames = size / 4U;
+	UINT32 nonzero = 0U;
+	UINT32 amplitudeMatches = 0U;
+	UINT32 crossings = 0U;
+	int previousSign = 0;
+	for (size_t frame = 0; frame < frames; frame++)
+	{
+		const size_t offset = frame * 4U;
+		const INT16 sample = (INT16)((UINT16)data[offset] | ((UINT16)data[offset + 1U] << 8U));
+		const INT32 magnitude = sample < 0 ? -(INT32)sample : (INT32)sample;
+		if (magnitude > 32)
+			nonzero++;
+		if (magnitude >= 3000 && magnitude <= 14000)
+			amplitudeMatches++;
+		const int sign = sample > 32 ? 1 : sample < -32 ? -1 : 0;
+		if (sign != 0)
+		{
+			if (previousSign != 0 && sign != previousSign)
+				crossings++;
+			previousSign = sign;
+		}
+	}
+	if (!(state->microphoneFlags & 1U))
+	{
+		if (nonzero > 0U)
+			state->microphonePreArmNonzero = 1U;
+	}
+	else if (state->ordinal == 1U && state->microphoneErrors == 0U)
+	{
+		/* Period is bound to this fixture nonce; no raw PCM enters the receipt. */
+		unsigned int prefix = 0U;
+		for (size_t index = 0; index < 4U; index++)
+		{
+			const char value = state->audioNonce[index];
+			prefix = prefix * 16U + (unsigned int)(value <= '9' ? value - '0' : value - 'a' + 10);
+		}
+		const UINT32 period = 32U + prefix % 64U;
+		const UINT32 expectedCrossings = (UINT32)(frames * 2U / period);
+		if (nonzero * 5U >= frames * 4U && amplitudeMatches * 2U >= frames &&
+		    crossings + 2U >= expectedCrossings && crossings <= expectedCrossings + 2U)
+		{
+			if (state->microphoneMatchingPackets < 60000U)
+				state->microphoneMatchingPackets++;
+			if (!(state->microphoneFlags & 2U))
+			{
+				emit_phase(state, "LRNMIC01");
+				state->microphoneFlags |= 2U;
+			}
+		}
+	}
+	LeaveCriticalSection(&state->lock);
+}
+
+static void write_microphone_witness(LarenorOwnedChannels* state)
+{
+	BYTE data[64] = { 0 };
+	memcpy(data, "LRNF62M1", 8U);
+	EnterCriticalSection(&state->lock);
+	write_uint32_le(data, 8U, 1U);
+	write_uint32_le(data, 12U, sizeof(data));
+	write_uint32_le(data, 16U, state->ordinal);
+	write_uint32_le(data, 20U, state->microphoneFlags);
+	write_uint32_le(data, 24U, state->microphonePackets);
+	write_uint32_le(data, 28U, state->microphoneMatchingPackets);
+	write_uint32_le(data, 32U, state->microphonePreArmNonzero);
+	write_uint32_le(data, 36U, state->microphoneErrors);
+	LeaveCriticalSection(&state->lock);
+	const int fd = open(state->microphoneWitnessPath, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return;
+	size_t offset = 0U;
+	while (offset < sizeof(data))
+	{
+		const ssize_t count = write(fd, &data[offset], sizeof(data) - offset);
+		if (count <= 0)
+			break;
+		offset += (size_t)count;
+	}
+	if (offset == sizeof(data))
+		(void)fsync(fd);
+	(void)close(fd);
+}
