+/**
+ * Private channel witness for the Larenor owned FreeRDP fixture.
+ *
+ * This source is compiled only with WITH_LARENOR_F62_OWNED_CHANNELS. It records
+ * counters and terminal booleans, never clipboard text or monitor-layout data.
+ */
+
+#include <freerdp/config.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <freerdp/channels/cliprdr.h>
+#include <freerdp/channels/disp.h>
+#include <freerdp/server/cliprdr.h>
+#include <freerdp/server/disp.h>
+#include <winpr/assert.h>
+#include <winpr/crt.h>
+#include <winpr/synch.h>
+
+#include "shadow_larenor_channels.h"
+
+#define LARENOR_MAX_CHANNEL_EVENTS 8U
+#define LARENOR_FLAG_CLIPBOARD_EFFECT 0x00000001U
+#define LARENOR_FLAG_DISP_EFFECT 0x00000002U
+#define LARENOR_PHASE_DISP 0x00000001U
+#define LARENOR_PHASE_CLIPBOARD 0x00000002U
+
+typedef struct
+{
+	CliprdrServerContext* cliprdr;
+	DispServerContext* disp;
+	CRITICAL_SECTION lock;
+	int phaseFd;
+	char witnessPath[PATH_MAX];
+	UINT32 expectedWidth;
+	UINT32 expectedHeight;
+	UINT32 ordinal;
+	UINT32 flags;
+	UINT32 phaseFlags;
+	UINT32 formatLists;
+	UINT32 dataRequests;
+	UINT32 dataResponses;
+	UINT32 emptyResponses;
+	UINT32 displayLayouts;
+	UINT32 channelErrors;
+} LarenorOwnedChannels;
+
+static volatile LONG g_authenticatedClientOrdinal = 0;
+
+static const BYTE CLIPBOARD_MARKER_UTF16LE[] = {
+	0x4C, 0x00, 0x61, 0x00, 0x72, 0x00, 0x65, 0x00, 0x6E, 0x00,
+	0x6F, 0x00, 0x72, 0x00, 0x2D, 0x00, 0x46, 0x00, 0x36, 0x00,
+	0x32, 0x00, 0x2D, 0x00, 0x30, 0x01, 0x5F, 0x01, 0x2D, 0x00,
+	0x3D, 0xD8, 0x00, 0xDE, 0x0D, 0x00, 0x0A, 0x00, 0x09, 0x00,
+	0x76, 0x00, 0x31, 0x00, 0x00, 0x00
+};
+
+static void write_uint32_le(BYTE* data, size_t offset, UINT32 value)
+{
+	data[offset] = (BYTE)(value & 0xFFU);
+	data[offset + 1] = (BYTE)((value >> 8U) & 0xFFU);
+	data[offset + 2] = (BYTE)((value >> 16U) & 0xFFU);
+	data[offset + 3] = (BYTE)((value >> 24U) & 0xFFU);
+}
+
+static BOOL parse_bounded_uint32(const char* name, UINT32 minimum, UINT32 maximum, UINT32* value)
+{
+	char* end = nullptr;
+	const char* raw = getenv(name);
+	if (!raw || !raw[0])
+		return FALSE;
+	errno = 0;
+	const unsigned long parsed = strtoul(raw, &end, 10);
+	if ((errno != 0) || !end || (*end != '\0') || (parsed < minimum) || (parsed > maximum))
+		return FALSE;
+	*value = (UINT32)parsed;
+	return TRUE;
+}
+
+static BOOL load_private_configuration(LarenorOwnedChannels* state)
+{
+	const char* path = getenv("LARENOR_F62_CHANNEL_WITNESS");
+	const char* phaseFd = getenv("LARENOR_F62_CHANNEL_PHASE_FD");
+	char* end = nullptr;
+	if (!path || (path[0] != '/') ||
+	    (strnlen(path, sizeof(state->witnessPath)) >= (sizeof(state->witnessPath) - 3U)))
+		return FALSE;
+	if (!parse_bounded_uint32("LARENOR_F62_EXPECT_WIDTH", 200U, 8192U, &state->expectedWidth) ||
+	    !parse_bounded_uint32("LARENOR_F62_EXPECT_HEIGHT", 200U, 8192U, &state->expectedHeight))
+		return FALSE;
+	if (!phaseFd || !phaseFd[0])
+		return FALSE;
+	errno = 0;
+	const long parsedFd = strtol(phaseFd, &end, 10);
+	if ((errno != 0) || !end || (*end != '\0') || (parsedFd < 3) || (parsedFd > 1024))
+		return FALSE;
+	state->phaseFd = fcntl((int)parsedFd, F_DUPFD, 3);
+	if (state->phaseFd < 0)
+		return FALSE;
+	if (fcntl(state->phaseFd, F_SETFD, FD_CLOEXEC) != 0)
+		return FALSE;
+	struct stat descriptor = { 0 };
+	if ((fstat(state->phaseFd, &descriptor) != 0) || !S_ISFIFO(descriptor.st_mode))
+		return FALSE;
+	const int descriptorFlags = fcntl(state->phaseFd, F_GETFL, 0);
+	if ((descriptorFlags < 0) ||
+	    (fcntl(state->phaseFd, F_SETFL, descriptorFlags | O_NONBLOCK) != 0))
+		return FALSE;
+	const LONG ordinal = InterlockedIncrement(&g_authenticatedClientOrdinal);
+	if ((ordinal < 1) || (ordinal > 2))
+		return FALSE;
+	state->ordinal = (UINT32)ordinal;
+	if (snprintf(state->witnessPath, sizeof(state->witnessPath), "%s.%ld", path,
+	             (long)ordinal) < 0)
+		return FALSE;
+	return TRUE;
+}
+
+static void increment_bounded(UINT32* value, UINT32* errors)
+{
+	if (*value < LARENOR_MAX_CHANNEL_EVENTS)
+		(*value)++;
+	else if (*errors < LARENOR_MAX_CHANNEL_EVENTS)
+		(*errors)++;
+}
+
+static void record_error(LarenorOwnedChannels* state)
+{
+	if (state->channelErrors < LARENOR_MAX_CHANNEL_EVENTS)
+		state->channelErrors++;
+}
+
+static void emit_phase(LarenorOwnedChannels* state, const char marker[8])
+{
+	if (state->ordinal != 1U)
+		return;
+	if (write(state->phaseFd, marker, 8U) != 8)
+		record_error(state);
+}
+
+static void emit_ready_phases(LarenorOwnedChannels* state)
+{
+	if ((state->flags & LARENOR_FLAG_DISP_EFFECT) &&
+	    ((state->phaseFlags & LARENOR_PHASE_DISP) == 0U))
+	{
+		emit_phase(state, "LRNDISP1");
+		state->phaseFlags |= LARENOR_PHASE_DISP;
+	}
+	if ((state->flags & LARENOR_FLAG_CLIPBOARD_EFFECT) &&
+	    (state->phaseFlags & LARENOR_PHASE_DISP) &&
+	    ((state->phaseFlags & LARENOR_PHASE_CLIPBOARD) == 0U))
+	{
+		emit_phase(state, "LRNCLIP1");
+		state->phaseFlags |= LARENOR_PHASE_CLIPBOARD;
+	}
+}
+
+static UINT on_client_format_list(CliprdrServerContext* context,
+	                              const CLIPRDR_FORMAT_LIST* formatList)
+{
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(formatList);
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)context->custom;
+	WINPR_ASSERT(state);
+
+	UINT32 requested = 0;
+	EnterCriticalSection(&state->lock);
+	increment_bounded(&state->formatLists, &state->channelErrors);
+	for (UINT32 index = 0; index < formatList->numFormats; index++)
+	{
+		if (formatList->formats[index].formatId == CF_UNICODETEXT)
+		{
+			requested = formatList->formats[index].formatId;
+			break;
+		}
+	}
+	LeaveCriticalSection(&state->lock);
+
+	CLIPRDR_FORMAT_LIST_RESPONSE response = {
+		.common = { .msgType = CB_FORMAT_LIST_RESPONSE, .msgFlags = CB_RESPONSE_OK, .dataLen = 0 }
+	};
+	UINT rc = context->ServerFormatListResponse(context, &response);
+	if ((rc == CHANNEL_RC_OK) && (requested != 0))
+	{
+		CLIPRDR_FORMAT_DATA_REQUEST request = {
+			.common = { .msgType = CB_FORMAT_DATA_REQUEST, .msgFlags = 0, .dataLen = 4 },
+			.requestedFormatId = requested
+		};
+		EnterCriticalSection(&state->lock);
+		if (state->dataRequests >= LARENOR_MAX_CHANNEL_EVENTS)
+		{
+			record_error(state);
+			LeaveCriticalSection(&state->lock);
+			return ERROR_INVALID_DATA;
+		}
+		state->dataRequests++;
+		LeaveCriticalSection(&state->lock);
+		rc = context->ServerFormatDataRequest(context, &request);
+	}
+	if (rc != CHANNEL_RC_OK)
+	{
+		EnterCriticalSection(&state->lock);
+		record_error(state);
+		LeaveCriticalSection(&state->lock);
+	}
+	return rc;
+}
+
+static UINT on_client_format_data_response(CliprdrServerContext* context,
+	                                       const CLIPRDR_FORMAT_DATA_RESPONSE* response)
+{
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(response);
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)context->custom;
+	WINPR_ASSERT(state);
+	const BOOL empty = (response->common.dataLen == 0U) ||
+	                   ((response->common.dataLen == 2U) && response->requestedFormatData &&
+	                    (response->requestedFormatData[0] == 0U) &&
+	                    (response->requestedFormatData[1] == 0U));
+	const BOOL exact = (response->common.msgFlags == CB_RESPONSE_OK) &&
+	                   (response->common.dataLen == sizeof(CLIPBOARD_MARKER_UTF16LE)) &&
+	                   response->requestedFormatData &&
+	                   (memcmp(response->requestedFormatData, CLIPBOARD_MARKER_UTF16LE,
+	                           sizeof(CLIPBOARD_MARKER_UTF16LE)) == 0);
+
+	EnterCriticalSection(&state->lock);
+	increment_bounded(&state->dataResponses, &state->channelErrors);
+	if (empty)
+		increment_bounded(&state->emptyResponses, &state->channelErrors);
+	else if (exact)
+	{
+		state->flags |= LARENOR_FLAG_CLIPBOARD_EFFECT;
+		emit_ready_phases(state);
+	}
+	else
+		record_error(state);
+	LeaveCriticalSection(&state->lock);
+	return CHANNEL_RC_OK;
+}
+
+static UINT on_monitor_layout(DispServerContext* context,
+	                          const DISPLAY_CONTROL_MONITOR_LAYOUT_PDU* pdu)
+{
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(pdu);
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)context->custom;
+	WINPR_ASSERT(state);
+	BOOL exact = FALSE;
+	if ((pdu->NumMonitors == 1U) && pdu->Monitors)
+	{
+		const DISPLAY_CONTROL_MONITOR_LAYOUT* monitor = &pdu->Monitors[0];
+		exact = (monitor->Flags == DISPLAY_CONTROL_MONITOR_PRIMARY) && (monitor->Left == 0) &&
+		        (monitor->Top == 0) && (monitor->Width == state->expectedWidth) &&
+		        (monitor->Height == state->expectedHeight) && (monitor->PhysicalWidth == 0U) &&
+		        (monitor->PhysicalHeight == 0U) && (monitor->Orientation == ORIENTATION_LANDSCAPE) &&
+		        (monitor->DesktopScaleFactor == 100U) && (monitor->DeviceScaleFactor == 100U);
+	}
+	EnterCriticalSection(&state->lock);
+	increment_bounded(&state->displayLayouts, &state->channelErrors);
+	if (exact)
+	{
+		state->flags |= LARENOR_FLAG_DISP_EFFECT;
+		emit_ready_phases(state);
+	}
+	else
+		record_error(state);
+	LeaveCriticalSection(&state->lock);
+	return CHANNEL_RC_OK;
+}
+
+static BOOL on_disp_channel_ready(DispServerContext* context, UINT32 channelId)
+{
+	WINPR_UNUSED(channelId);
+	WINPR_ASSERT(context);
+	context->MaxNumMonitors = 1U;
+	context->MaxMonitorAreaFactorA = 8192U;
+	context->MaxMonitorAreaFactorB = 8192U;
+	return TRUE;
+}
+
+static UINT on_disp_ready(DispServerContext* context)
+{
+	WINPR_ASSERT(context);
+	return context->DisplayControlCaps(context);
+}
+
+static void write_witness(LarenorOwnedChannels* state)
+{
+	BYTE data[64] = { 0 };
+	memcpy(data, "LRNF62C1", 8U);
+	EnterCriticalSection(&state->lock);
+	write_uint32_le(data, 8U, 1U);
+	write_uint32_le(data, 12U, sizeof(data));
+	write_uint32_le(data, 16U, state->flags);
+	write_uint32_le(data, 20U, state->formatLists);
+	write_uint32_le(data, 24U, state->dataRequests);
+	write_uint32_le(data, 28U, state->dataResponses);
+	write_uint32_le(data, 32U, state->emptyResponses);
+	write_uint32_le(data, 36U, state->displayLayouts);
+	write_uint32_le(data, 40U, state->channelErrors);
+	LeaveCriticalSection(&state->lock);
+
+	const int fd = open(state->witnessPath, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return;
+	size_t offset = 0;
+	while (offset < sizeof(data))
+	{
+		const ssize_t written = write(fd, &data[offset], sizeof(data) - offset);
+		if (written <= 0)
+			break;
+		offset += (size_t)written;
+	}
+	if (offset == sizeof(data))
+		(void)fsync(fd);
+	(void)close(fd);
+}
+
+UINT shadow_larenor_channels_init(rdpShadowClient* client)
+{
+	WINPR_ASSERT(client);
+	LarenorOwnedChannels* state = calloc(1, sizeof(*state));
+	if (!state)
+		return CHANNEL_RC_NO_MEMORY;
+	state->phaseFd = -1;
+	InitializeCriticalSection(&state->lock);
+	if (!load_private_configuration(state))
+		goto fail;
+
+	const BOOL clipboardJoined =
+	    WTSVirtualChannelManagerIsChannelJoined(client->vcm, CLIPRDR_SVC_CHANNEL_NAME);
+	if (((state->ordinal == 1U) && !clipboardJoined) ||
+	    ((state->ordinal == 2U) && clipboardJoined))
+		goto fail;
+
+	if (clipboardJoined)
+	{
+		state->cliprdr = cliprdr_server_context_new(client->vcm);
+		if (!state->cliprdr)
+			goto fail;
+		state->cliprdr->custom = state;
+		state->cliprdr->rdpcontext = &client->context;
+		state->cliprdr->ClientFormatList = on_client_format_list;
+		state->cliprdr->ClientFormatDataResponse = on_client_format_data_response;
+		if (state->cliprdr->Start(state->cliprdr) != CHANNEL_RC_OK)
+			goto fail;
+	}
+
+	state->disp = disp_server_context_new(client->vcm);
+	if (!state->disp)
+		goto fail;
+	state->disp->custom = state;
+	state->disp->rdpcontext = &client->context;
+	state->disp->ChannelIdAssigned = on_disp_channel_ready;
+	state->disp->Ready = on_disp_ready;
+	state->disp->DispMonitorLayout = on_monitor_layout;
+	if (state->disp->Open(state->disp) != CHANNEL_RC_OK)
+		goto fail;
+
+	client->larenorOwnedChannels = state;
+	return CHANNEL_RC_OK;
+
+fail:
+	if (state->disp)
+		disp_server_context_free(state->disp);
+	if (state->cliprdr)
+	{
+		(void)state->cliprdr->Stop(state->cliprdr);
+		cliprdr_server_context_free(state->cliprdr);
+	}
+	if (state->witnessPath[0])
+	{
+		record_error(state);
+		write_witness(state);
+	}
+	if (state->phaseFd >= 0)
+		(void)close(state->phaseFd);
+	DeleteCriticalSection(&state->lock);
+	free(state);
+	return ERROR_NOT_READY;
+}
+
+void shadow_larenor_channels_free(rdpShadowClient* client)
+{
+	if (!client || !client->larenorOwnedChannels)
+		return;
+	LarenorOwnedChannels* state = (LarenorOwnedChannels*)client->larenorOwnedChannels;
+	client->larenorOwnedChannels = nullptr;
+	if (state->disp)
+		disp_server_context_free(state->disp);
+	if (state->cliprdr)
+	{
+		(void)state->cliprdr->Stop(state->cliprdr);
+		cliprdr_server_context_free(state->cliprdr);
+	}
+	write_witness(state);
+	if (state->phaseFd >= 0)
+		(void)close(state->phaseFd);
+	DeleteCriticalSection(&state->lock);
+	free(state);
+}
--- a/server/shadow/shadow_larenor_channels.h
+++ b/server/shadow/shadow_larenor_channels.h
@@ -0,0 +1,10 @@
+/** Private owned-fixture channel witness. Not installed as a public API. */
+#ifndef FREERDP_SERVER_SHADOW_LARENOR_CHANNELS_H
+#define FREERDP_SERVER_SHADOW_LARENOR_CHANNELS_H
+
+#include <freerdp/server/shadow.h>
+
+WINPR_ATTR_NODISCARD UINT shadow_larenor_channels_init(rdpShadowClient* client);
+void shadow_larenor_channels_free(rdpShadowClient* client);
+
+#endif
