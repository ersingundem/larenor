+++ b/server/shadow/shadow_owned_rdpdr.c	2026-10-03 18:38:59
@@ -0,0 +1,553 @@
+#include <freerdp/config.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <sys/stat.h>
