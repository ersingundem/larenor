FROM ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 AS uv

FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/larenor
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --python /usr/local/bin/python3
COPY server/larenor_server ./larenor_server
RUN uv sync --locked --no-dev --no-editable --python /usr/local/bin/python3

FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /opt/larenor
COPY --from=build /opt/larenor/.venv ./.venv
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/larenor-keenetic-worker/
RUN /usr/sbin/groupadd --gid 10001 larenor && \
    /usr/sbin/useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin larenor
USER 10001:10001
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/opt/larenor/.venv/bin/larenor-keenetic-worker", "--policy", "/run/secrets/keenetic-worker-policy.json", "--socket", "/run/larenor/keenetic-worker.sock", "--health", "/run/larenor/keenetic-worker-health.json", "--api-uid", "10001", "--health-check"]
ENTRYPOINT ["/opt/larenor/.venv/bin/larenor-keenetic-worker"]
CMD ["--policy", "/run/secrets/keenetic-worker-policy.json", "--socket", "/run/larenor/keenetic-worker.sock", "--health", "/run/larenor/keenetic-worker-health.json", "--api-uid", "10001"]
